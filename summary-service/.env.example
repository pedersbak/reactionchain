# URL for the CVR Elasticsearch endpoint.
# Virk/E&S open distribution endpoint (requires user/pass):
CVR_ES_URL=https://distribution.virk.dk/cvr-permanent/virksomhed/_search

# Basic-auth credentials for the CVR Elasticsearch endpoint.
# Register at: https://datacvr.virk.dk/artikel/system-til-system-adgang-til-cvr-data
CVR_ES_USER=your_virk_username
CVR_ES_PASS=your_virk_password

# Groq API key — free at https://console.groq.com
GROQ_API_KEY=your_groq_api_key

# Port for the summary service (default: 3001)
PORT=3001
