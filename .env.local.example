# Copy this file to .env.local to point the CVR proxy at a local backend.
# .env.local is gitignored — safe to put real values here.
#
# Leave this file as-is (or don't create .env.local) to use the production
# backend at https://netvrk.nu.

# Uncomment to use a local cvr-adapter instead:
# CVR_TARGET=http://localhost:5039
